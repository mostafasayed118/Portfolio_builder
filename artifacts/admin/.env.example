VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key
VITE_CLERK_JWT_TEMPLATE=admin
VITE_CLERK_ISSUER=https://your-clerk-issuer.clerk.accounts.dev
VITE_ADMIN_EMAILS=admin@example.com
VITE_supABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PORTFOLIO_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5174
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://your-site.com

# The VITE_CLERK_JWT_TEMPLATE name must match a JWT template you create
# in Clerk Dashboard (Sessions → JWT Templates). The template must include
# the `email` claim so the server's adminAuth middleware can read it:
#
#   Claim Name: email
#   Claim Value: {{user.primary_email_address}}
#
# Without the template, admin requests get 401 from the server because
# the default Clerk session JWT does NOT include the email.
