SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CSRF_SECRET=
PORT=3001
VITE_SITE_URL=
VITE_ADMIN_URL=
LOG_LEVEL=info
ADMIN_API_KEY=
# Server-only admin allowlist (comma-separated emails). NEVER prefix with VITE_.
ADMIN_EMAILS=
CLERK_SECRET_KEY=
CLERK_ISSUER=
VITE_CLERK_PUBLISHABLE_KEY=

# Shared rate-limit store (optional). Without it, rate limits are per-instance
# and dilute across serverless instances.
# REDIS_URL=

# Cloudflare Turnstile (optional contact CAPTCHA); obtain from Cloudflare dashboard
TURNSTILE_SECRET_KEY=

# Email (Gmail SMTP - app password) for contact notifications + message replies
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# CONTACT_NOTIFY_EMAIL=you@gmail.com
# Branding for email templates (optional)
# SITE_NAME=
# ADMIN_URL=
