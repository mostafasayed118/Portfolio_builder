SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CSRF_SECRET=
PORT=3001
VITE_SITE_URL=
VITE_ADMIN_URL=
LOG_LEVEL=info
# Comma-separated admin email allowlist (server-only; do NOT use a VITE_ prefix)
ADMIN_EMAILS=admin@example.com
ADMIN_API_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
VITE_CLERK_PUBLISHABLE_KEY=

# Cloudflare Turnstile (optional contact CAPTCHA); obtain from Cloudflare dashboard
TURNSTILE_SECRET_KEY=

# Email (Gmail SMTP - app password) for contact notifications + message replies
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# CONTACT_NOTIFY_EMAIL=you@gmail.com
# Branding for email templates (optional)
# SITE_NAME=
# ADMIN_URL=

# --- AI (xAI Grok / any OpenAI-compatible provider) ---
# Get a key at https://console.groq.com (free tier, no credit card).
# Leave AI_API_KEY empty to disable all AI features (safe default).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_SPAM_MODEL=llama-3.3-70b-versatile
AI_CHAT_ENABLED=true
AI_WRITING_ENABLED=true
AI_SPAM_ENABLED=false
AI_SPAM_THRESHOLD=75
AI_CHAT_RATE_LIMIT_MAX=20
AI_CHAT_RATE_LIMIT_WINDOW_MS=900000
AI_CONTEXT_TTL_MS=60000
AI_TIMEOUT_MS=20000
AI_SPAM_TIMEOUT_MS=3000
AI_CHAT_MAX_TURNS=10
