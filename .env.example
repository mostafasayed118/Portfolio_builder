# =============================================================================
# Portfolio-Fixer — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# --- Supabase (required) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Clerk Auth (required for admin) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# --- Admin access ---
# Comma-separated email addresses that are allowed admin access
VITE_ADMIN_EMAILS=admin@example.com
# Server-side API key for local dev (never use VITE_ prefix — it exposes the key in client bundle)
ADMIN_API_KEY=your-admin-api-key

# --- CSRF (required for API server) ---
CSRF_SECRET=your-csrf-secret-at-least-32-chars

# --- URLs ---
VITE_SITE_URL=https://your-portfolio.vercel.app
VITE_ADMIN_URL=https://your-admin.vercel.app
VITE_API_URL=https://your-api-server.vercel.app

# --- Optional ---
VITE_TWITTER_HANDLE=@yourhandle
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
LOG_LEVEL=info
PORT=3001

# --- OpenCode MCP (only used by `opencode` CLI / IDE integration) ---
# TestSprite MCP API key — referenced from opencode.json via {env:TESTSPRITE_API_KEY}
# Get one at: https://testsprite.com (or wherever your account is managed)
TESTSPRITE_API_KEY=sk-user-...
