# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

.env.local
.env

.vercel

# Turbo build cache
.turbo

# Local scratch / tooling artifacts
.freebuff/
.openclaude/
.worktrees/
*.tmp.mjs

# Test artifacts (should never be tracked)
playwright-report/
test-results/
test-*.log
playwright/.auth/
screenshots/

# TestSprite
testsprite_tests/

# Windows NUL device artifacts
nul

# Supabase CLI local state
supabase/.temp/

# Pulled/derived env dumps (contain live secrets — never commit)
*.env.tmp
*.env.e2e-*
.e2e-*

# Temp inspection artifacts
.tmp-img/

# local E2E mailbox credentials (never committed)
e2e/.auth-mailtm.json

# Tool caches and generated dumps (never commit — credentials, AST dumps,
# zips of pasted assets). `list/` holds Vercel CLI auth tokens.
list/
graphify-out/
.kilo/
attached_assets/

# Build/scratch debris
admin-build-output.txt
COMMIT_MSG.txt
