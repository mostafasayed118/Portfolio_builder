# Keep deploys lean, but NEVER exclude build outputs (dist/out) — Vercel
# applies this file to git deployments too, so excluding dist would strip
# the SPA build output and fail the deploy. Only skip deps and tooling dirs.
.git
.vercel
node_modules
artifacts/*/node_modules
lib/*/node_modules
skills
testsprite_tests
graphify-out
.tmp-img
coverage
artifacts/*/coverage
lib/*/coverage
